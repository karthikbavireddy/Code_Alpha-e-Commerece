# =====================================================================
# Django E-Commerce Configuration
# =====================================================================
# Copy this file to '.env' and modify values to match your environment.
# Example in PowerShell: Copy-Item .env.example .env

# --- General Django Settings ---
SECRET_KEY=django-insecure-change-this-in-production-^5x9!e(7v
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# =====================================================================
# DATABASE CONFIGURATION
# =====================================================================
# For Neon PostgreSQL (Serverless Postgres):
# 1. Sign in to https://console.neon.tech
# 2. Copy the Connection String (pooled or unpooled)
# 3. Paste it below as DATABASE_URL with ?sslmode=require
#
# NEON POSTGRESQL (Recommended):
# DATABASE_URL=postgresql://[user]:[password]@[ep-your-project].us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Other PostgreSQL (Local / Render / Supabase):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/ecommerce_db
#
# SQLite (Local Dev Fallback):
# DATABASE_URL=sqlite:///db.sqlite3

# ---------------------------------------------------------------------
# METHOD 2: Using discrete variables
# ---------------------------------------------------------------------
# Choose engine: 'postgresql', 'mysql', or 'sqlite3'
DB_ENGINE=sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- PostgreSQL Example ---
# DB_ENGINE=postgresql
# DB_NAME=ecommerce_db
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432

# --- MySQL Example ---
# DB_ENGINE=mysql
# DB_NAME=ecommerce_db
# DB_USER=root
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=3306
